{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "schedule": ["before 9am on monday"],
  "automerge": false,
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "enabled": true
    },
    {
      "description": "Pinned by k8s.io/apimachinery; moves with k8s.io bumps",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["k8s.io/kube-openapi", "sigs.k8s.io/structured-merge-diff/**"],
      "enabled": false
    }
  ],
  "postUpdateOptions": ["gomodTidy"]
}
